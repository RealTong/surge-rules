# BankUS_Domain — 美国银行 (Clash 域名/通配形式转换)

# Source: https://github.com/Accademia/Additional_Rule_For_Clash/blob/main/Bank/BankUS_Domain.yaml

# Clash -> Surge mapping:
#   DOMAIN-SUFFIX  -> DOMAIN-SUFFIX
#   DOMAIN         -> DOMAIN
#   DOMAIN-KEYWORD -> DOMAIN-KEYWORD
#   '+.a.com'      -> DOMAIN-SUFFIX,a.com
#   '+.a.*'        -> DOMAIN-WILDCARD,a.*  (+ '*.a.*' 覆盖前缀子域)

# -----------------------------------------------
# [银行]：美国银行     [Default : US ]
# -----------------------------------------------
DOMAIN-SUFFIX,hsbc.com.us                           # 汇丰美国     HSBC North America Holdings
DOMAIN,us.hsbc.com                                  # 汇丰美国     HSBC North America Holdings
DOMAIN-SUFFIX,us.hsbc.com                           # 汇丰美国     HSBC North America Holdings
DOMAIN-WILDCARD,vam-us.*.vv1865.com                 # 汇丰美国     HSBC North America Holdings
DOMAIN-WILDCARD,*.vam-us.*.vv1865.com               # 汇丰美国     HSBC North America Holdings
# ---------- Plaid ---------- #  # 银行间协作
DOMAIN-SUFFIX,plaid.com
# ---------- Plaid ---------- #  # 银行间协
DOMAIN-SUFFIX,zellepay.com
DOMAIN-SUFFIX,zelle.com
# ---------- Chase ---------- #
DOMAIN-SUFFIX,chase.com                             # 摩根大通    Chase
# -------- Wellsfargo -------- #
DOMAIN-SUFFIX,wellsfargo.com                        # 富国银行    Wellsfargo
# -------- Citibank -------- #
DOMAIN-SUFFIX,citi.com                              # 花旗银行    Citibank
DOMAIN-SUFFIX,citibank.com                          # 花旗银行    Citibank
# ------ Bank of America ----- #
DOMAIN-SUFFIX,bankofamerica.com                     # 美洲银行    Bank of America
DOMAIN-WILDCARD,bankofamerica.*                     # 美洲银行    Bank of America
DOMAIN-WILDCARD,*.bankofamerica.*                   # 美洲银行    Bank of America
DOMAIN-WILDCARD,bankofamerica1.*                    # 美洲银行    Bank of America
DOMAIN-WILDCARD,*.bankofamerica1.*                  # 美洲银行    Bank of America
DOMAIN-SUFFIX,bac-assets.com                        # 美洲银行    Bank of America
# --------- US Bank --------- #
DOMAIN-SUFFIX,usbank.com                            # 美国合众银行  U.S. Bancorp
# ------- 信用卡 银行 ------- #
DOMAIN-SUFFIX,capitalone.com                        # 第一资本     Capital One Financial
DOMAIN-SUFFIX,americanexpress.com                   # 美国运通     American Express Company
DOMAIN-SUFFIX,discover.com                          # 发现卡       Discover Financial Services
DOMAIN-SUFFIX,synchronybank.com                     # 同步银行     Synchrony （Paypal在美国的合作银行）
# ------ 中资背景 银行 ------- #
DOMAIN-SUFFIX,velobank.com                          # 华美汇丰     EastWest
DOMAIN-SUFFIX,eastwest.com                          # 华美汇丰     EastWest
DOMAIN-WILDCARD,eastwestbank.*                      # 华美汇丰     EastWest
DOMAIN-WILDCARD,*.eastwestbank.*                    # 华美汇丰     EastWest
DOMAIN-SUFFIX,cm.everesttech.net                    # 华美汇丰     EastWest
DOMAIN-SUFFIX,epayments-epaystatic-e.money-movement.com # 华美汇丰     EastWest
DOMAIN-SUFFIX,cathaybank.com                        # 国泰汇丰     Cathay Bank
DOMAIN-SUFFIX,q2ebanking.com                        # 国泰汇丰     Cathay Bank
DOMAIN-SUFFIX,savvymoney.com                        # 国泰汇丰     Cathay Bank
DOMAIN-SUFFIX,onlineaccess1.com                     # 国泰汇丰     Cathay Bank
